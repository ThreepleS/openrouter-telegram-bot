# Telegram bot token from @BotFather.
BOT_TOKEN=

# Telegram user ID allowed to use admin commands and access the bot by default.
ADMIN_ID=

# SQLite database path. Relative path is resolved from the project root.
# Ignored when USE_SUPABASE_DB=1 (data lives in Supabase Postgres instead).
DB_PATH=bot.db

# --- Supabase database (cloud backend) ---
# Set USE_SUPABASE_DB=1 to store all bot data (users, whitelist, messages,
# favorites, stats) in Supabase Postgres instead of the local SQLite file.
USE_SUPABASE_DB=0
SUPABASE_URL=https://amhszfvqruzpydqyjlya.supabase.co
# service_role key — server-side only, NEVER expose to clients/frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Optional proxy for Telegram polling. Usually empty; aiogram session uses system proxy/VPN by default.
# PROXY=http://127.0.0.1:7890

# Optional server-side API keys. If set, they take priority over user keys for the matching provider.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_API_KEY=
VENICE_API_KEY=

# --- Web App / PWA (Telegram Mini App) ---
# Host/port for the local aiohttp server that serves the PWA and Mini App API.
# Set WEB_APP_PORT=0 to disable the web app entirely.
WEB_APP_HOST=0.0.0.0
WEB_APP_PORT=8080

# Public HTTPS URL of the web app root. Telegram requires HTTPS for Mini Apps.
# Used to set the bot Menu Button. Leave empty to skip (local/dev only).
# WEB_APP_URL=https://your-domain.example

# Dev auth: when "1", /api/auth and /api/chat accept a raw ?dev_user=<id>
# instead of a valid Telegram initData. NEVER enable in production.
WEB_APP_DEV=0
